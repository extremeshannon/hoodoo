# Copy to `.env` for docker compose. Used on first DB init only (bootstrap creates user if email is new).
# Never commit `.env`.
BOOTSTRAP_STAFF_EMAIL=admin@hoodooak.com
BOOTSTRAP_STAFF_USERNAME=admin
BOOTSTRAP_STAFF_PASSWORD=change-this-password
BOOTSTRAP_STAFF_ROLE=admin

# Base URL for password-reset links (no trailing slash). Docker desktop: http://localhost:8004
PUBLIC_BASE_URL=http://localhost:8004

# Optional SMTP — if unset, reset links are logged by the API (see forgot-password / server logs).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
